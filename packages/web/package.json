{
  "name": "sigitex.palace.web",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Sigitex",
    "url": "https://sigitex.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigitex/palace.git"
  },
  "files": [
    "src",
    "app",
    "shared",
    "server"
  ],
  "scripts": {
    "start": "bunx --bun vite --host",
    "build": "bunx --bun vite build",
    "serve": "bun --watch --tsconfig-override tsconfig.server.json server/server.ts",
    "serve:test": "bun --tsconfig-override tsconfig.server.json server/server.ts",
    "check": "tsc --build",
    "test": "bun test --pass-with-no-tests --tsconfig-override tsconfig.test.json",
    "test:browser": "playwright test",
    "format:check": "oxfmt --check .",
    "generate:icons": "bun scripts/generate-board-icons.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@sigitex/bind": "^1.1.2",
    "@sigitex/outlaw": "workspace:*",
    "@sigitex/route": "workspace:*",
    "@sigitex/ssjs": "workspace:*",
    "arktype": "^2.2.3",
    "nanoid": "^6.0.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/dates": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mantine/notifications": "^9.4.2",
    "@mantine/spotlight": "^9.4.2",
    "@playwright/test": "1.62.1",
    "@types/bun": "^1.3.13",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "bun-types": "^1.3.14",
    "js-cookie": "^3.0.8",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "postcss": "^8.5.23",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "valtio": "^2.3.2",
    "vite": "^8.1.5",
    "wouter": "^3.10.0"
  }
}
