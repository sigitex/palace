{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": [],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "paths": {
      "assets/*": [
        "./assets/*"
      ],
      "@/*": [
        "./app/*"
      ],
      "$/*": [
        "./server/*"
      ],
      "shared/*": [
        "./shared/*"
      ]
    }
  }
}
